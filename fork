
#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>

int main()
{
    int n, i, j, temp;
    int a[100], b[100];

    printf("Enter number of integers: ");
    scanf("%d", &n);

    if(n <= 0 || n > 100)
    {
        printf("Invalid number of integers!\n");
        return 1;
    }

    printf("Enter %d integers:\n", n);

    for(i = 0; i < n; i++)
    {
        scanf("%d", &a[i]);
        b[i] = a[i];
    }

    pid_t pid = fork();

    if(pid < 0)
    {
        printf("Fork failed!\n");
        return 1;
    }

    else if(pid == 0)
    {
        // Child process: Selection Sort
        printf("\nChild Process\n");
        printf("Child PID: %d\n", getpid());

        for(i = 0; i < n - 1; i++)
        {
            int min = i;

            for(j = i + 1; j < n; j++)
            {
                if(b[j] < b[min])
                    min = j;
            }

            temp = b[i];
            b[i] = b[min];
            b[min] = temp;
        }

        printf("Array sorted by Child (Selection Sort):\n");

        for(i = 0; i < n; i++)
            printf("%d ", b[i]);

        printf("\n");

        exit(0);
    }

    else
    {
        // Parent process: Bubble Sort
        printf("\nParent Process\n");
        printf("Parent PID: %d\n", getpid());
        printf("Child PID: %d\n", pid);

        for(i = 0; i < n - 1; i++)
        {
            for(j = 0; j < n - i - 1; j++)
            {
                if(a[j] > a[j + 1])
                {
                    temp = a[j];
                    a[j] = a[j + 1];
                    a[j + 1] = temp;
                }
            }
        }

        printf("Array sorted by Parent (Bubble Sort):\n");

        for(i = 0; i < n; i++)
            printf("%d ", a[i]);

        printf("\n");

        // Parent waits for child process
        wait(NULL);

        printf("\nParent process completed after child.\n");
    }

    return 0;
}
