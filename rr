#include <stdio.h>
#include <stdlib.h>

int main()
{
    int n, tq, i, time = 0, completed = 0;
    int at[10], bt[10], rem[10], ct[10], wt[10], tat[10];
    int queue[100], front = 0, rear = 0;
    int visited[10] = {0};

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++)
    {
        printf("Enter Arrival Time and First CPU Burst for P%d: ", i + 1);
        scanf("%d %d", &at[i], &bt[i]);
        rem[i] = bt[i];
    }

    printf("Enter Time Quantum: ");
    scanf("%d", &tq);

    printf("\nGantt Chart:\n");

    while(completed < n)
    {
        /* Add newly arrived processes */
        for(i = 0; i < n; i++)
        {
            if(at[i] <= time && visited[i] == 0)
            {
                queue[rear++] = i;
                visited[i] = 1;
            }
        }

        /* CPU idle */
        if(front == rear)
        {
            time++;
            continue;
        }

        i = queue[front++];

        printf("| P%d ", i + 1);

        if(rem[i] > tq)
        {
            time += tq;
            rem[i] -= tq;
        }
        else
        {
            time += rem[i];
            rem[i] = 0;
            completed++;

            ct[i] = time;
            tat[i] = ct[i] - at[i];
            wt[i] = tat[i] - bt[i];

            /* Generate next CPU burst randomly */
            if(completed < n)
                bt[i] += rand() % 5 + 1;
        }

        /* Add newly arrived processes */
        for(int j = 0; j < n; j++)
        {
            if(at[j] <= time && visited[j] == 0)
            {
                queue[rear++] = j;
                visited[j] = 1;
            }
        }

        /* Re-enter ready queue if process is not complete */
        if(rem[i] > 0)
            queue[rear++] = i;
    }

    printf("|\n");

    printf("\nProcess\tAT\tBT\tWT\tTAT\n");

    float avg_wt = 0, avg_tat = 0;

    for(i = 0; i < n; i++)
    {
        printf("P%d\t%d\t%d\t%d\t%d\n",
               i + 1, at[i], bt[i], wt[i], tat[i]);

        avg_wt += wt[i];
        avg_tat += tat[i];
    }

    printf("\nAverage Waiting Time = %.2f", avg_wt / n);
    printf("\nAverage Turnaround Time = %.2f\n", avg_tat / n);

    return 0;
}
