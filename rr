#include <stdio.h>

int main()
{
    int n, tq;
    int pid[20], at[20], bt[20], rem[20];
    int ct[20], tat[20], wt[20];
    int i, j, temp;
    int time = 0, completed = 0;
 float awt=0,att=0;
    printf("Enter number of processes: ");
    scanf("%d", &n);

    printf("Enter Arrival Time and Burst Time:\n");

    for(i = 0; i < n; i++)
    {
        pid[i] = i + 1;
        printf("P%d: ", pid[i]);
        scanf("%d %d", &at[i], &bt[i]);

        rem[i] = bt[i];
    }

    printf("Enter Time Quantum: ");
    scanf("%d", &tq);

    // Sort according to Arrival Time
    for(i = 0; i < n - 1; i++)
    {
        for(j = i + 1; j < n; j++)
        {
            if(at[i] > at[j])
            {
                temp = at[i];
                at[i] = at[j];
                at[j] = temp;

                temp = bt[i];
                bt[i] = bt[j];
                bt[j] = temp;

                temp = rem[i];
                rem[i] = rem[j];
                rem[j] = temp;

                temp = pid[i];
                pid[i] = pid[j];
                pid[j] = temp;
            }
        }
    }

    // Round Robin
    time = at[0];

    while(completed < n)
    {
        for(i = 0; i < n; i++)
        {
            if(at[i] <= time && rem[i] > 0)
            {
                if(rem[i] > tq)
                {
                    time = time + tq;
                    rem[i] = rem[i] - tq;
                }
                else
                {
                    time = time + rem[i];
                    rem[i] = 0;

                    ct[i] = time;
                    tat[i] = ct[i] - at[i];
                    
                    
                    wt[i] = tat[i] - bt[i];

                    completed++;
                }
            }
        }
    }

    printf("\nPID\tAT\tBT\tCT\tTAT\tWT\n");

    for(i = 0; i < n; i++)
    {
        printf("P%d\t%d\t%d\t%d\t%d\t%d\n", pid[i], at[i], bt[i],ct[i], tat[i], wt[i]);
    }
    for(i=0; i<n; i++)
  {
    awt=awt+wt[i];
    att=att+tat[i];
  }
  awt=awt/n;
  att=att/n;
  printf("\n");
  printf("\nAverage Waiting Time = %.2f",awt);
  printf("\nAverage Turnaround Time = %.2f",att);
  printf("\n");

    return 0;
    
    
  
    
    
    
    
    
    
}

