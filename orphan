
#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/types.h>

int main()
{
    pid_t pid;

    pid = fork();

    if (pid < 0)
    {
        printf("Fork failed!\n");
        exit(1);
    }
    else if (pid == 0)
    {
        // Child process
        printf("\nChild Process Started\n");
        printf("Child Process ID: %d\n", getpid());
        printf("Parent Process ID: %d\n", getppid());

        sleep(5);

        printf("\nAfter parent termination:\n");
        printf("Child Process ID: %d\n", getpid());
        printf("New Parent Process ID: %d\n", getppid());

        printf("Child process has become an orphan.\n");
    }
    else
    {
        // Parent process
        printf("Parent Process Started\n");
        printf("Parent Process ID: %d\n", getpid());
        printf("Child Process ID: %d\n", pid);

        sleep(1);

        printf("\nParent process is terminating.\n");
        exit(0);
    }

    return 0;
}
