
#include <stdio.h>

int main()
{
    int n, frames, i, j, k;
    int pages[100], memory[20];
    int pageFaults = 0, front = 0;
    int found;

    printf("Enter number of pages: ");
    scanf("%d", &n);

    printf("Enter the page reference string:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &pages[i]);

    printf("Enter number of frames: ");
    scanf("%d", &frames);

    for(i = 0; i < frames; i++)
        memory[i] = -1;

    printf("\nPage\tFrames\t\tStatus\n");

    for(i = 0; i < n; i++)
    {
        found = 0;

        // Check whether page is already present
        for(j = 0; j < frames; j++)
        {
            if(memory[j] == pages[i])
            {
                found = 1;
                break;
            }
        }

        if(found == 0)
        {
            memory[front] = pages[i];
            front = (front + 1) % frames;
            pageFaults++;
        }

        printf("%d\t", pages[i]);

        for(j = 0; j < frames; j++)
        {
            if(memory[j] == -1)
                printf("- ");
            else
                printf("%d ", memory[j]);
        }

        if(found == 0)
            printf("\tPage Fault");
        else
            printf("\tHit");

        printf("\n");
    }

    printf("\nTotal Page Faults = %d\n", pageFaults);
    printf("Total Page Hits = %d\n", n - pageFaults);

    return 0;
}
