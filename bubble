#include<stdio.h>
# include<stdlib.h>
#include<unistd.h>
#include<sys/types.h>
#include<sys/wait.h>
void bubblesort(int arr[],int n)
{
for(int i=0;i<n;i++)
{
for(int j=0;j<n-1;j++)
{
if(arr[j]>arr[j+1])
{
int temp=arr[j];
arr[j]=arr[j+1];
arr[j+1]=temp;
}
}
}
void insertionsort(int arr[],int n)
{
for(int i=0;i<n;i++)
{
int key=arr[i];
int j=i-1;
while(j>=0 & arr[j]>key)
{
arr[j+1]=arr[j];
j--;
}
arr[j+1]=key;
}
}
