#include <stdio.h>
#include <stdlib.h>

int main()
{
int n, i;
int head, total = 0;

printf("Enter number of requests: ");
scanf("%d", &n);

int request[n];

printf("Enter request queue:\n");
for(i = 0; i < n; i++)
{
scanf("%d", &request[i]);
}

printf("Enter initial head position: ");
scanf("%d", &head);

printf("\nSeek Sequence: %d", head);

for(i = 0; i < n; i++)
{
total = total + abs(request[i] - head);
head = request[i];

printf(" -> %d", head);
}

printf("\n\nTotal Head Movement = %d cylinders", total);

return 0;
}
