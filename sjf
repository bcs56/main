
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

struct Process
{
    int pid;
    int at, bt1, bt2, total;
    int ct, tat, wt;
    int done;
};

int main()
{
    struct Process p[20], temp;
    int n, i, j, time = 0;
    int completed = 0, minIndex;
    float avgWT = 0, avgTAT = 0;

    srand(time(NULL));

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++)
    {
        p[i].pid = i + 1;

        printf("\nEnter arrival time of P%d: ", i + 1);
        scanf("%d", &p[i].at);

        printf("Enter first CPU burst of P%d: ", i + 1);
        scanf("%d", &p[i].bt1);

        // Generate second CPU burst randomly
        p[i].bt2 = rand() % 10 + 1;

        p[i].total = p[i].bt1 + p[i].bt2;
        p[i].done = 0;

        printf("Random next CPU burst of P%d = %d\n",
               i + 1, p[i].bt2);
    }

    printf("\nGANTT CHART\n");

    printf("0");

    while(completed < n)
    {
        minIndex = -1;

        // Select shortest available process
        for(i = 0; i < n; i++)
        {
            if(p[i].done == 0 && p[i].at <= time)
            {
                if(minIndex == -1 ||
                   p[i].total < p[minIndex].total)
                {
                    minIndex = i;
                }
            }
        }

        // CPU is idle
        if(minIndex == -1)
        {
            printf(" -- Idle -- %d", time + 1);
            time++;
            continue;
        }

        // Execute selected process
        printf(" -- P%d -- %d",
               p[minIndex].pid,
               time + p[minIndex].total);

        time += p[minIndex].total;

        p[minIndex].ct = time;
        p[minIndex].tat = p[minIndex].ct - p[minIndex].at;
        p[minIndex].wt = p[minIndex].tat - p[minIndex].total;

        p[minIndex].done = 1;
        completed++;
    }

    printf("\n\nPROCESS DETAILS\n");

    printf("PID\tAT\tBT1\tBT2\tTOTAL\tCT\tTAT\tWT\n");

    for(i = 0; i < n; i++)
    {
        printf("P%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\n",
               p[i].pid,
               p[i].at,
               p[i].bt1,
               p[i].bt2,
               p[i].total,
               p[i].ct,
               p[i].tat,
               p[i].wt);

        avgWT += p[i].wt;
        avgTAT += p[i].tat;
    }

    avgWT /= n;
    avgTAT /= n;

    printf("\nAverage Waiting Time = %.2f", avgWT);
    printf("\nAverage Turnaround Time = %.2f\n", avgTAT);

    return 0;
}
