#include <stdio.h>
#include <limits.h>

#define MAX 10

int main()
{
    int at[MAX], bt[MAX], rt[MAX];      /* arrival, burst, remaining time */
    int ct[MAX], wt[MAX], tat[MAX];     /* completion, waiting, turnaround */
    int n, i, time = 0, done = 0, shortest, min;
    int sum_wait = 0, sum_tat = 0;

    printf("Enter number of processes (max %d): ", MAX);
    scanf("%d", &n);
    if (n < 1 || n > MAX)
    {
        printf("Invalid number of processes.\n");
        return 1;
    }

    for (i = 0; i < n; i++)
    {
        printf("Enter arrival time and burst time of P%d: ", i + 1);
        scanf("%d%d", &at[i], &bt[i]);
        rt[i] = bt[i];
    }

    /* Run the CPU one time unit at a time */
    while (done < n)
    {
        shortest = -1;
        min = INT_MAX;

        /* Pick the arrived process with the smallest remaining time */
        for (i = 0; i < n; i++)
        {
            if (at[i] <= time && rt[i] > 0 && rt[i] < min)
            {
                min = rt[i];
                shortest = i;
            }
        }

        /* No process is ready: CPU stays idle for 1 unit */
        if (shortest == -1)
        {
            time++;
            continue;
        }

        rt[shortest]--;   /* run it for 1 unit */
        time++;

        if (rt[shortest] == 0)   /* process finished */
        {
            done++;
            ct[shortest]  = time;
            tat[shortest] = ct[shortest] - at[shortest];
            wt[shortest]  = tat[shortest] - bt[shortest];
            sum_wait += wt[shortest];
            sum_tat  += tat[shortest];
        }
    }

    printf("\nProcess\tAT\tBT\tCT\tTAT\tWT\n");
    for (i = 0; i < n; i++)
        printf("P%d\t%d\t%d\t%d\t%d\t%d\n", i + 1, at[i], bt[i], ct[i], tat[i], wt[i]);

    printf("\nAverage Waiting Time    = %.2f\n", (float)sum_wait / n);
    printf("Average Turnaround Time = %.2f\n", (float)sum_tat / n);

    return 0;
}
