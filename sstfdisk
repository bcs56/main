#include <stdio.h>
void main()
{
  int n,i,head,total=0,count=0,abs();
  printf("\nHow many requests: ");
  scanf("%d",&n);
  int a[n];
  printf("Enter actual requests: ");
  for(i=0; i<n; i++)
    scanf("%d",&a[i]);
  printf("Enter initial head location: ");
  scanf("%d",&head);
  while(count!=n)
  {
    int min=500,d=0,index;
    for(i=0; i<n; i++)
    {
      d=abs(a[i]-head);
      if(min>=d)
      {
        min=d;
        index=i;
      }
    }
    total=total+min;
    head=a[index];
    a[index]=500;
    count++;
  }
printf("\n*** Total Head Movements: %d\n",total);
}
